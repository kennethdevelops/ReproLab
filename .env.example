# Copy to .env and fill in locally. Never commit .env.

# --- Application ---
APP_ENV=local
# local | public_demo
APP_MODE=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
POSTGRES_USER=reprolab
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=reprolab
DATABASE_URL=postgresql+psycopg://reprolab:CHANGE_ME@postgres:5432/reprolab
REDIS_URL=redis://redis:6379/0
ARTIFACTS_DIR=/data/artifacts
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Model provider ("bring your own model") ---
# anthropic          Anthropic API (ANTHROPIC_API_KEY)
# openai_compatible  any /v1/chat/completions server with tool calling (LLM_BASE_URL, LLM_API_KEY)
# replay             replays a transcript recorded with LLM_RECORD_PATH; labelled "replay:" in reports
# (stub is test-only.) Check your setup: cd backend && uv run python -m reprolab.agent.check_model
# No model is set by default; pick one of the presets below.
LLM_PROVIDER=openai_compatible
LLM_MODEL=
# low | medium | high | xhigh | max  (anthropic only)
LLM_EFFORT=medium
LLM_MAX_TOKENS_PER_CALL=8000
# Anthropic server-side refusal fallback (beta). Disable if your account lacks access.
LLM_REFUSAL_FALLBACK=true
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
# Send strict: true on function tools (OpenAI supports it; many local servers do not).
LLM_STRICT_TOOLS=false
# Optional JSON price table, USD per million tokens: {"my-model": {"input": 0.5, "output": 1.5}}
# Models without a price get token/step budgets only; cost shows as "not estimated" and
# MAX_RUN_COST_USD cannot protect them. Add a price for any paid model.
LLM_PRICES_FILE=
LLM_REPLAY_PATH=
LLM_RECORD_PATH=
#
# Presets (uncomment one block; the model must support tool calling):
# Anthropic:   LLM_PROVIDER=anthropic LLM_MODEL=<model id> ANTHROPIC_API_KEY=...
# Ollama:      LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=qwen3:8b
#              (from Docker: LLM_BASE_URL=http://host.docker.internal:11434/v1)
# LM Studio:   LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://localhost:1234/v1 LLM_MODEL=<loaded model id>
# OpenAI:      LLM_PROVIDER=openai_compatible LLM_BASE_URL=https://api.openai.com/v1 LLM_MODEL=<model> LLM_API_KEY=sk-... LLM_STRICT_TOOLS=true
# Gemini:      LLM_PROVIDER=openai_compatible LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=<model> LLM_API_KEY=...
# Groq:        LLM_PROVIDER=openai_compatible LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=<model> LLM_API_KEY=...
# OpenRouter:  LLM_PROVIDER=openai_compatible LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=<vendor/model> LLM_API_KEY=...
# Replay:      LLM_PROVIDER=replay LLM_REPLAY_PATH=../benchmarks/transcripts/<file>.json

# --- Regression-test runner (isolated Node + Playwright; runs tests against demo fixtures only) ---
# Docker sets this for you. Local dev: cd test-runner && BUGGY_URL=... FIXED_URL=... npm start
TEST_RUNNER_URL=

# --- Embeddings ---
# fastembed = local ONNX model, no API key | hashing = deterministic test-only embedder
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Bounded execution (starting values, tune from measurement) ---
MAX_BROWSER_STEPS=25
MAX_RETRIEVAL_CALLS=10
MAX_INVESTIGATION_SECONDS=300
MAX_MODEL_CALLS=30
MAX_INPUT_TOKENS_PER_RUN=400000
MAX_OUTPUT_TOKENS_PER_RUN=40000
MAX_RUN_COST_USD=1.00
MAX_CONCURRENT_INVESTIGATIONS=1
MAX_QUEUED_INVESTIGATIONS=10
MAX_BUG_REPORT_CHARS=4000
PUBLIC_DEMO_DAILY_COST_CAP_USD=2.00

# --- Security and repository/browser scope ---
PUBLIC_DEMO_ENABLED=false
DEMO_ALLOWED_ORIGIN=http://demo-target:4173
# Fixed-variant fixture for test validation/evaluation only; never an investigation target.
DEMO_FIXED_ORIGIN=http://demo-target-fixed:4173
# Extra origins allowed in local mode only (comma-separated). Leave empty unless you mean it.
LOCAL_EXTRA_ALLOWED_ORIGINS=
GITHUB_PUBLIC_REPO_ENABLED=true
ALLOW_PRIVATE_REPOS=false
GITHUB_TOKEN=

# --- Demo target ---
# buggy | fixed  (selects the fixture variant served by demo-target; never visible to the agent)
DEMO_FIXTURE_MODE=buggy
# Shared secret for the fixture reset endpoint. Required; reset is refused without it.
DEMO_ADMIN_TOKEN=CHANGE_ME_TOO

# --- Frontend build-time configuration (never a secret) ---
VITE_API_BASE_URL=http://localhost:8000
